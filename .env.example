# NavithLabs event API. The independent local service runs on port 8001.
# Set the public NavithLabs API URL before building a release for other players.
VITE_NAVITHLABS_API_BASE_URL=http://127.0.0.1:8001
# Optional fallback API hosts, ordered after the primary.
# VITE_NAVITHLABS_API_BASE_URLS=https://backup.example.com

# Leave disabled until signed NavithLabs update artifacts and a public key are configured.
VITE_NAVITHLABS_UPDATER_ENABLED=false

# Optional separate host for files served from /storage.
# VITE_NAVITHLABS_STORAGE_BASE_URL=

# Optional Minecraft server status provider.
# VITE_SERVER_STATUS_BASE_URL=https://api.mcsrvstat.us/2
