{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NavithLabs Launcher",
  "version": "0.1.0",
  "identifier": "com.navithlabs.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NavithLabs Launcher",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "center": true,
        "visible": false,
        "decorations": false,
        "maximized": true,
        "minWidth": 960,
        "minHeight": 600
      },
      {
        "label": "splashscreen",
        "title": "Cargando NavithLabs Launcher",
        "url": "/splash.html",
        "width": 400,
        "height": 500,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.youtube.com https://s.ytimg.com https://*.youtube.com https://*.ytimg.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https:; img-src 'self' data: asset: http://asset.localhost blob: https: http:; media-src 'self' blob: data: https: http:; connect-src 'self' asset: http://asset.localhost blob: https: http: ws: wss:; style-src 'self' 'unsafe-inline' https:; font-src 'self' data: https:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "NavithLabs",
    "copyright": "Copyright © 2026 NavithLabs",
    "shortDescription": "Launcher para Minecraft y Modpacks",
    "longDescription": "NavithLabs Launcher para gestionar Minecraft, mods e instancias.",
    "category": "Game",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "./icons/icon.ico",
        "headerImage": "./nsis/header.bmp",
        "sidebarImage": "./nsis/sidebar.bmp",
        "startMenuFolder": "NavithLabs",
        "languages": [
          "Spanish"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
